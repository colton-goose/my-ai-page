<title>Wisewell · Amazon.ae PPC Dashboard</title>
<style>
*, *::before, *::after { box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f8f8f6; color: #1a1a1a; margin: 0; padding: 0; line-height: 1.4; min-height: 100vh; }

/* Top bar */
.ww-topbar { position: sticky; top: 0; z-index: 100; background: rgba(248,248,246,0.95); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 0.5px solid rgba(0,0,0,0.1); padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.ww-topbar-title { font-size: 13px; font-weight: 500; color: #1a1a1a; margin: 0; }
.ww-topbar-sub   { font-size: 10px; color: #9ca3af; margin: 0; }
.ww-upload-btn   { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: #1a1a1a; background: #fff; border: 0.5px solid rgba(0,0,0,0.2); border-radius: 6px; padding: 6px 12px; cursor: pointer; transition: background 0.12s; white-space: nowrap; user-select: none; }
.ww-upload-btn:hover { background: #f0efea; }
#csv-input { display: none; }

/* Drop overlay */
.ww-drop { display: none; position: fixed; inset: 0; background: rgba(29,158,117,0.05); border: 2px dashed rgba(29,158,117,0.45); z-index: 999; align-items: center; justify-content: center; font-size: 15px; font-weight: 500; color: #0F6E56; pointer-events: none; }
.ww-drop.active { display: flex; }

/* Empty state */
.ww-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: calc(100vh - 57px); padding: 40px 24px; text-align: center; }
.ww-empty-icon { width: 52px; height: 52px; background: #f0efea; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; }
.ww-empty-cta  { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 500; color: #1a1a1a; background: #fff; border: 0.5px solid rgba(0,0,0,0.2); border-radius: 7px; padding: 9px 20px; cursor: pointer; transition: background 0.12s; user-select: none; }
.ww-empty-cta:hover { background: #f0efea; }

/* Dashboard */
.ww-wrap { max-width: 960px; margin: 0 auto; padding: 20px 24px 48px; }

/* KPI cards */
.ww-g4 { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px; margin-bottom: 1.25rem; }
.ww-kpi { background: #f0efea; border-radius: 8px; padding: .9rem 1rem; }
.ww-kpi p { margin: 0; line-height: 1.3; }

/* Period selector */
.period-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem; flex-wrap: wrap; }
.period-lbl { font-size: 10px; color: #9ca3af; white-space: nowrap; }
.period-grp { display: flex; background: #f0efea; border-radius: 6px; padding: 2px; gap: 2px; overflow-x: auto; flex-shrink: 0; }
.period-btn { font-size: 11px; font-weight: 500; color: #6b7280; background: transparent; border: none; border-radius: 4px; padding: 4px 10px; cursor: pointer; transition: all 0.12s; white-space: nowrap; }
.period-btn:hover { background: rgba(0,0,0,0.05); color: #1a1a1a; }
.period-btn.active { background: #fff; color: #1a1a1a; box-shadow: 0 1px 2px rgba(0,0,0,0.08); }

/* Chart card */
.ww-card { background: #fff; border: 0.5px solid rgba(0,0,0,0.1); border-radius: 12px; padding: 1.1rem 1.25rem; margin-bottom: .9rem; }
.ww-leg  { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 10px; }
.ww-li   { display: flex; align-items: center; gap: 5px; font-size: 11px; color: #6b7280; }

@media (max-width: 620px) {
  .ww-g4   { grid-template-columns: repeat(2,1fr); }
  .ww-wrap { padding: 16px 16px 40px; }
}
